{
  "name": "nucawebsite",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:frontdoor": "wrangler pages deploy public --project-name=nucawebsite --cwd frontdoor --commit-dirty=true",
    "migrate": "wrangler d1 migrations apply nuca-lv --remote",
    "migrate:local": "wrangler d1 migrations apply nuca-lv --local",
    "types": "wrangler types",
    "check": "wrangler check",
    "build:admin-editor": "esbuild scripts/admin-post-editor/main.ts --bundle --outfile=public/admin-post-editor.js --format=iife --target=es2020 --minify",
    "import-members": "node scripts/import-wp-members.mjs",
    "import-leadership": "node scripts/import-wp-leadership.mjs",
    "fix-event-timezones": "node scripts/fix-event-timezones.mjs",
    "fix-event-timezones:remote": "node scripts/fix-event-timezones.mjs --remote",
    "backup-events": "node scripts/backup-events.mjs",
    "backup-events:remote": "node scripts/backup-events.mjs --remote",
    "restore-events": "node scripts/restore-events.mjs",
    "restore-events:remote": "node scripts/restore-events.mjs --remote"
  },
  "dependencies": {
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-color": "^3.33.0",
    "@tiptap/extension-font-family": "^3.33.0",
    "@tiptap/extension-highlight": "^3.33.0",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-link": "^3.33.0",
    "@tiptap/extension-placeholder": "^3.33.0",
    "@tiptap/extension-text-align": "^3.33.0",
    "@tiptap/extension-text-style": "^3.33.0",
    "@tiptap/extension-underline": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.158.0"
  }
}
